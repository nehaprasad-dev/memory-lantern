# Groq API key (free tier works). Create one at https://console.groq.com/keys
# Server-side only: never prefix it with NEXT_PUBLIC_.
GROQ_API_KEY=

# Open-weight model to use.
GROQ_MODEL=openai/gpt-oss-20b

# OpenAI-compatible base URL. Change this to use a self-hosted server (vLLM, Ollama, llama.cpp).
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Reasoning effort for GPT-OSS: low | medium | high | none (none omits the parameter).
GROQ_REASONING_EFFORT=low

# Requests per minute per IP for /api/generate.
RATE_LIMIT_PER_MINUTE=8
