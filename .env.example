# Hugging Face access token with the "Make calls to Inference Providers" permission.
# Create one at https://huggingface.co/settings/tokens
HF_TOKEN=

# Open-weight model to use. Append ":provider" to pin a provider, e.g. openai/gpt-oss-20b:groq
HF_MODEL=openai/gpt-oss-20b

# OpenAI-compatible base URL. Change this to use a self-hosted server (vLLM, Ollama, llama.cpp).
HF_BASE_URL=https://router.huggingface.co/v1

# Reasoning effort for GPT-OSS: low | medium | high | none (none omits the parameter).
HF_REASONING_EFFORT=low

# Requests per minute per IP for /api/generate.
RATE_LIMIT_PER_MINUTE=8
